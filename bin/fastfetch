#!/bin/bash
# Animated text T.A.R.D.I.S fastfetch logo. No graphics protocol or screen clears.
set -uo pipefail

FF=/usr/bin/fastfetch
FRAME_FILE="$HOME/.config/fastfetch/tardis-text-frames"
PAD=42
DELAY=0.12

# Flags go to the real binary. The animation only replaces a plain startup call.
if [ "$#" -ne 0 ] || [ ! -r "$FRAME_FILE" ]; then
    exec "$FF" "$@"
fi

info="$("$FF" --logo none "$@" 2>/dev/null)"
lines="$(printf '%s\n' "$info" | wc -l)"
pad="$(printf '%*s' "$PAD" '')"
info="$(printf '%s\n' "$info" | sed "s/^/$pad/")"

mapfile -d $'\f' -t frames < "$FRAME_FILE"

printf '%s\n' "$info"

saved=0
cleanup() {
    if [ "$saved" -eq 1 ]; then
        printf '\033[u'
    fi
    printf '\033[?25h'
}
trap cleanup EXIT INT TERM

printf '\033[s'
saved=1
printf '\033[?25l'

for frame in "${frames[@]}"; do
    frame="${frame%$'\n'}"
    frame="$(printf '%s\n' "$frame" | awk -v n="$lines" '
        NR <= n { print }
        END { for (i = NR + 1; i <= n; i++) print "" }
    ')"

    # Return to the saved prompt row, then move up to the logo's first row.
    printf '\033[u\033[%sA\033[1G' "$lines"
    printf '%s\n' "$frame"
    sleep "$DELAY"
done

printf '\033[u'
saved=0
printf '\033[?25h'
trap - EXIT INT TERM
