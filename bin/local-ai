#!/bin/bash
set -euo pipefail

ACTION="${1:-status}"
shift || true

case "$ACTION" in
    start)
        systemctl --user start local-ai.service local-ai-proxy.service
        echo "Local AI starting on http://127.0.0.1:8080"
        ;;
    stop)
        systemctl --user stop local-ai-proxy.service local-ai.service
        echo "Local AI stopped"
        ;;
    restart)
        systemctl --user restart local-ai.service
        systemctl --user restart local-ai-proxy.service
        echo "Local AI restarted"
        ;;
    enable)
        systemctl --user enable --now local-ai.service local-ai-proxy.service
        echo "Local AI enabled at login"
        ;;
    disable)
        systemctl --user disable --now local-ai-proxy.service local-ai.service
        echo "Local AI disabled at login"
        ;;
    status)
        systemctl --user status local-ai.service local-ai-proxy.service --no-pager 2>&1 || true
        ;;
    log)
        journalctl --user -u local-ai.service -u local-ai-proxy.service -f
        ;;
    chat)
        exec "$HOME/.local/bin/llama-chat" "$@"
        ;;
    models)
        curl -sS http://127.0.0.1:8080/v1/models | python3 -m json.tool
        ;;
    ask)
        QUESTION="$*"
        if [ -z "$QUESTION" ]; then
            echo "Usage: local-ai ask <question>" >&2
            exit 1
        fi
        curl -sS http://127.0.0.1:8080/v1/chat/completions \
            -H 'Content-Type: application/json' \
            -d "$(python3 -c 'import json,sys; print(json.dumps({"model":"qwen2.5-coder-7b","messages":[{"role":"user","content":sys.argv[1]}],"temperature":0.7,"max_tokens":1024}))' "$QUESTION")" \
            | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d["choices"][0]["message"]["content"])'
        ;;
    *)
        echo "Usage: local-ai {start|stop|restart|enable|disable|status|log|chat|models|ask}" >&2
        exit 1
        ;;
esac
