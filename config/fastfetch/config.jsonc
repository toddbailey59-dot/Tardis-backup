{
    "$schema": "https://raw.githubusercontent.com/fastfetch/fastfetch/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/doctor/.config/fastfetch/tardis-gold.png",
        "width": 40,
        "height": 28,
        "padding": {
            "right": 2,
            "top": 1
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "94",
            "title": "36"
        }
    },
    "modules": [
        { "type": "title", "key": "╭" },
        { "type": "os", "key": "├ OS" },
        { "type": "kernel", "key": "├ Kernel" },
        { "type": "host", "key": "├ Host" },
        { "type": "uptime", "key": "├ Uptime" },
        { "type": "packages", "key": "├ Packages" },
        { "type": "shell", "key": "├ Shell" },
        { "type": "terminal", "key": "├ Terminal" },
        { "type": "wm", "key": "├ WM" },
        { "type": "cpu", "key": "├ CPU" },
        { "type": "gpu", "key": "├ GPU" },
        { "type": "display", "key": "├ Resolution" },
        { "type": "memory", "key": "├ Memory" },
        { "type": "disk", "key": "├ Disk" },
        { "type": "publicip", "key": "├ Public Ip" },
        { "type": "localip", "key": "├ Local Ip" },
        {
            "type": "colors",
            "symbol": "circle",
            "key": "╰ TARDIS"
        }

    ]
}
