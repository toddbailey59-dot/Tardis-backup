{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen2.5-coder-7b",
  "providers": {
    "local": {
      "name": "TARDIS Local AI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "compatibility": {
        "maxTokensField": "max_tokens",
        "streamUsage": false
      },
      "models": {
        "qwen2.5-coder-7b": {
          "modelID": "qwen2.5-coder-7b",
          "name": "Qwen2.5 Coder 7B (local Vulkan)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  }
}
